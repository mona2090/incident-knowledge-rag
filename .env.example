# Configuration template: copy to .env ONLY for a NEW setup.
# Defaults below do not mirror your active settings. Unknown keys are blank.
# Keep credentials in .env; never commit .env.

PINECONE_API_KEY=
PINECONE_INDEX_NAME=incident-knowledge-rag
PINECONE_NAMESPACE=incident-assistant
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
CHUNK_SIZE=256
CHUNK_OVERLAP=40
DENSE_TOP_K=10
KEYWORD_TOP_K=10
HYBRID_TOP_K=10
RERANK_TOP_N=5
RRF_K=60
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
GENERATION_MAX_TOKENS=1500
GENERATION_TIMEOUT_SECONDS=60
CONTEXT_MAX_CHARS=16000
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=incident-knowledge-rag
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
EVAL_JUDGE_MODEL=
RAG_INPUT_USD_PER_MILLION=
RAG_OUTPUT_USD_PER_MILLION=
PIPELINE_VERSION=incident-rag-v1
ANTHROPIC_WORKSPACE_ID=
APP_ENV=
LOG_LEVEL=
